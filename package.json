{
  "name": "zynkra",
  "private": true,
  "scripts": {
    "lint": "npm run lint:client && npm run lint:server",
    "lint:client": "cd client && npm run lint",
    "lint:server": "cd server && npm run lint",
    "test": "npm run test:client && npm run test:server",
    "test:client": "cd client && npm run test -- --run",
    "test:server": "cd server && npm run test:unit && npm run test:claims && npm run test:money",
    "test:ci": "npm run test:client && npm run test:server",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "cd client && npx tsc --noEmit",
    "typecheck:server": "cd server && npx tsc --noEmit",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "multer": "^2.3.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "prettier": "^3.0.0"
  }
}
