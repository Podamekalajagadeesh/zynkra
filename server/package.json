{
  "name": "server",
  "version": "1.0.0",
  "description": "V1 Social Media Platform Server",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:claims && npm run test:money",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=/test/",
    "test:e2e": "jest --runInBand --runTestsByPath test/e2e-smoke.test.ts",
    "test:core": "jest --runInBand --runTestsByPath test/core-loop.test.ts test/core-loop.integration.test.ts",
    "test:core-db": "jest --runInBand --runTestsByPath test/core-loop.db.integration.test.ts",
    "test:money": "jest --runInBand --runTestsByPath test/money-path.test.ts test/payments.payouts.spec.ts test/payments.webhooks.spec.ts test/payments.reconciliation.spec.ts",
    "test:qa": "jest --runInBand --runTestsByPath test/qa-smoke.test.ts test/e2e-smoke.test.ts",
    "test:claims": "jest --runInBand --runTestsByPath test/e2ee.dm.spec.ts test/data-export.portability.spec.ts test/federation-wellknown.spec.ts",
    "test:admin-marketplace": "jest --runInBand --runTestsByPath test/marketplace-listings.spec.ts test/admin-reports.spec.ts",
    "test:federation": "jest --runInBand src/federation",
    "test:integration": "jest --runInBand --testPathIgnorePatterns=/src/",
    "test:coverage": "jest --runInBand --coverage --testPathIgnorePatterns=/test/",
    "migration:generate": "node scripts/generate-migration.js",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:verify": "node scripts/verify-migrations.js",
    "migration:adopt": "node scripts/adopt-baseline.js",
    "qa:check": "node scripts/qa-check.js",
    "federation:probe": "node scripts/federation-probe.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.27",
    "@sentry/nestjs": "^10.66.0",
    "@simplewebauthn/server": "^9.0.3",
    "@tensorflow/tfjs-node": "^4.14.0",
    "@types/archiver": "^8.0.0",
    "@types/multer": "^2.1.0",
    "@types/passport-facebook": "^3.0.4",
    "@types/stripe": "^8.0.416",
    "archiver": "^8.0.0",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "canvas": "^2.11.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.4.0",
    "ethers": "^6.17.0",
    "express-session": "^1.19.0",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "kubo-rpc-client": "^7.0.0",
    "libsodium-wrappers": "^0.8.4",
    "livekit-server-sdk": "^2.15.5",
    "mongoose": "^8.24.0",
    "multer": "^2.2.0",
    "nestjs-pino": "^4.6.1",
    "node-html-parser": "^9.0.1",
    "nodemailer": "^8.0.8",
    "nsfwjs": "^4.2.0",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-discord": "^0.1.4",
    "passport-facebook": "^3.0.0",
