# Zynkra server environment — copy to .env and fill in real values.
# NEVER commit .env.

# REQUIRED — server refuses to start without these
JWT_SECRET=generate-a-long-random-string
SESSION_SECRET=generate-another-long-random-string

# Auth — token lifetimes
# Access token lifetime for non-remembered sessions (default 60m).
JWT_EXPIRES_IN=60m
# Access token lifetime when the user checks "Remember me" (default 30d).
JWT_REMEMBER_ME_EXPIRES=30d
# Magic-link sign-in token lifetime in minutes (default 15).
MAGIC_LINK_TTL_MINUTES=15
# CAPTCHA on signin. This is an anti-bot speed bump, NOT proof of a human — the
# expression is returned to the client and any script can solve it. Real step-up
# auth is TOTP (/auth/2fa) or a passkey.
# true  = every signin must solve a CAPTCHA
# false = a CAPTCHA is demanded only when one is supplied, or when risk triggers
#         it (see CAPTCHA_FAILURE_THRESHOLD below)
CAPTCHA_REQUIRED_ON_SIGNIN=false
# Demand a CAPTCHA once an identifier has this many failed sign-ins in the
# window. Counted from security_audit_logs, so it works across instances. 0
# disables the risk trigger.
CAPTCHA_FAILURE_THRESHOLD=3
CAPTCHA_FAILURE_WINDOW_MINUTES=15

# CSRF protection for session-authenticated routes (webauthn verification, SIWE
# verify, wallet connect). The session cookie is the only credential on those
# routes, so a cross-site page could otherwise drive them. Fetch
# GET /auth/csrf-token once and echo the value in the X-CSRF-Token header.
# Bearer-token requests and GET/HEAD/OPTIONS always bypass the check, so ordinary
# API calls are unaffected.
CSRF_PROTECTION_ENABLED=true
CSRF_COOKIE_NAME=zynkra.csrf

# Server-side idle timeout in minutes, enforced on every authenticated request
# against LoginSession.lastSeenAt. An idle session past this is revoked and the
# caller gets 401. 0 (default) disables it and relies on JWT expiry alone —
# turn it on once you have decided the right value for your product, because
# it logs users out mid-workflow if set too low.
SESSION_IDLE_TIMEOUT_MINUTES=0

# Email verification code redemption. The code is 6 digits with a 1-hour life, so
# these are the real barrier — the per-IP throttle on /auth/verify-code is only
# the first of two. Exceeding the attempt count locks redemption until the
# cooldown passes; requesting a new code clears the lock.
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_LOCKOUT_MINUTES=15
# Expected `aud` claim on API access tokens (default zynkra-api). Must match the
# value the server validates against on every request and WebSocket handshake.
JWT_AUDIENCE=zynkra-api

# Auth — Google OAuth. Without these, "Sign in with Google" is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_CALLBACK_URL=http://localhost:3000/auth/twitter/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback

# Encryption key for linked provider access tokens and OAuth state signatures.
LINKED_ACCOUNT_ENCRYPTION_KEY=generate-a-long-random-string

# Public URLs used to build email links, OAuth redirects, and WebAuthn validation.
CLIENT_URL=https://app.zynkra.com
SERVER_URL=https://api.zynkra.com
# If your front-end host differs from the top-level domain, set these explicitly.
WEBAUTHN_ORIGIN=https://app.zynkra.com
WEBAUTHN_RP_ID=app.zynkra.com

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zynkra

# Environment: development | production
NODE_ENV=development

# Payments (disabled by default; see payments module)
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
# Signing secret for POST /webhooks/stripe (Stripe → server). Required for
# payment_intent.* / transfer.* / charge.refunded events.
STRIPE_WEBHOOK_SECRET=
# true (default when payments are on) to use Stripe Connect transfers.
# Set false to force the manual admin-approved payout queue.
STRIPE_CONNECT_ENABLED=

# Server port
PORT=3000

# Reverse-proxy hops to trust for X-Forwarded-For.
# 1 = one proxy in front of the server (typical). Set to false if the server is
# directly exposed to the internet. NEVER set true: that means "believe any
# client's forwarded header", which lets someone spoof their IP and defeats
# new-device login detection and the security audit log.
TRUST_PROXY=1

# Max entries in the in-memory translation cache (LRU). The key includes
# user-supplied text, so this must stay bounded.
TRANSLATION_CACHE_MAX_ENTRIES=1000

# WebSocket / real-time
# Allowed socket origins (comma-separated). Defaults to CLIENT_URL, plus the
# local dev origins when NODE_ENV != production. In production an empty value
# means sockets accept no browser origin at all.
WS_ALLOWED_ORIGINS=
# Inbound socket messages allowed per socket per minute. Beyond this the message
# is dropped and an `error` event is sent; after WS_RATE_LIMIT_CLOSE_AFTER
# consecutive violations the socket is disconnected.
WS_RATE_LIMIT_PER_MINUTE=240
WS_RATE_LIMIT_CLOSE_AFTER=5

# Mobile prototype demo endpoints (default false — leave off).
# GET /mobile/feed and POST /mobile/posts serve a hardcoded in-memory array and
# accept unauthenticated writes. They exist only so the Expo prototype in
# mobile/ has something to talk to. Enable locally if you need them; the mobile
# client should be pointed at the real authenticated API instead.
MOBILE_DEMO_ENDPOINTS_ENABLED=false

# Media / uploads
# Local disk backend for images, video, and audio (Phase 1 default).
# Relative paths are served at GET /uploads/… by the API server.
UPLOAD_DIR=./uploads
# Optional CDN/asset origin. When set, upload responses return absolute
# URLs under this base instead of relative /uploads/… paths.
CDN_BASE_URL=

# Data-export archives (scheduled/manual account exports).
# Private directory for export zips — NOT under uploads/, so archives are
# only reachable through the authenticated GET /data-export/archive/:id.
EXPORT_DIR=./exports
# Days to keep an archive before it is pruned (history rows survive with
# fileUrl cleared). 0 disables retention pruning entirely.
EXPORT_RETENTION_DAYS=30

# Run pending migrations automatically on startup (true | false)
DB_MIGRATIONS_RUN=true

# Federation / ActivityPub (disabled by default)
# Outbound delivery, instance-block lists, and cross-instance sync are all 503
# until this is true. WebFinger / nodeinfo stay public.
FEDERATION_ENABLED=false
# Public hostname of this instance, e.g. social.example.com
INSTANCE_DOMAIN=
# Full public base URL, e.g. https://social.example.com
INSTANCE_BASE_URL=

# Crypto / on-chain payouts (disabled by default)
CRYPTO_PAYOUTS_ENABLED=false
# Private key for the payout disbursement wallet. NEVER commit a funded key.
CRYPTO_PAYOUT_PRIVATE_KEY=
# Comma-separated chain IDs permitted for payouts (8453 = Base).
CRYPTO_PAYOUT_CHAINS=8453

# Observability (optional — disabled when unset)
SENTRY_DSN=
# 0..1 fraction of requests traced (default 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# fatal | error | warn | info | debug | trace (default: info in prod, debug in dev)
LOG_LEVEL=

# AI / OpenRouter (optional — features fall back to templates when unset)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TEXT_MODEL=openai/gpt-4o-mini
AI_VISION_MODEL=openai/gpt-4o
AI_ANALYSIS_MODEL=openai/gpt-4o-mini
AI_FALLBACK_ENABLED=true
# Giphy API key for the GIF search proxy (optional — disables GIF search when unset)
GIPHY_API_KEY=your_giphy_api_key

# Email (SMTP) — required for real verification/password-reset emails.
# Falls back to console logging when SMTP_HOST is unset. Resend example below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address. Must be allowed by your provider (e.g. verified domain, or Resend's onboarding@resend.dev sandbox).
FROM_EMAIL=
