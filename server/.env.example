# Zynkra server environment — copy to .env and fill in real values.
# NEVER commit .env.

# REQUIRED — server refuses to start without these
JWT_SECRET=generate-a-long-random-string
SESSION_SECRET=generate-another-long-random-string

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zynkra

# Environment: development | production
NODE_ENV=development

# Payments (disabled by default; see payments module)
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
