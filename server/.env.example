# Zynkra server environment — copy to .env and fill in real values.
# NEVER commit .env.

# REQUIRED — server refuses to start without these
JWT_SECRET=generate-a-long-random-string
SESSION_SECRET=generate-another-long-random-string

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zynkra

# Environment: development | production
NODE_ENV=development

# Payments (disabled by default; see payments module)
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=

# Server port
PORT=3000

# Run pending migrations automatically on startup (true | false)
DB_MIGRATIONS_RUN=true

# Observability (optional — disabled when unset)
SENTRY_DSN=
# 0..1 fraction of requests traced (default 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# fatal | error | warn | info | debug | trace (default: info in prod, debug in dev)
LOG_LEVEL=

# AI / OpenRouter (optional — features fall back to templates when unset)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TEXT_MODEL=openai/gpt-4o-mini
AI_VISION_MODEL=openai/gpt-4o
AI_ANALYSIS_MODEL=openai/gpt-4o-mini
AI_FALLBACK_ENABLED=true
# Giphy API key for the GIF search proxy (optional — disables GIF search when unset)
GIPHY_API_KEY=your_giphy_api_key
