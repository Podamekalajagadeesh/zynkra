# Zynkra server environment — copy to .env and fill in real values.
# NEVER commit .env.

# REQUIRED — server refuses to start without these
JWT_SECRET=generate-a-long-random-string
SESSION_SECRET=generate-another-long-random-string

# Auth — token lifetimes
# Access token lifetime for non-remembered sessions (default 60m).
JWT_EXPIRES_IN=60m
# Access token lifetime when the user checks "Remember me" (default 30d).
JWT_REMEMBER_ME_EXPIRES=30d
# Magic-link sign-in token lifetime in minutes (default 15).
MAGIC_LINK_TTL_MINUTES=15

# Auth — Google OAuth. Without these, "Sign in with Google" is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_CALLBACK_URL=http://localhost:3000/auth/twitter/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback

# Encryption key for linked provider access tokens and OAuth state signatures.
LINKED_ACCOUNT_ENCRYPTION_KEY=generate-a-long-random-string

# Public URLs used to build email links, OAuth redirects, and WebAuthn validation.
CLIENT_URL=https://app.zynkra.com
SERVER_URL=https://api.zynkra.com
# If your front-end host differs from the top-level domain, set these explicitly.
WEBAUTHN_ORIGIN=https://app.zynkra.com
WEBAUTHN_RP_ID=app.zynkra.com

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=zynkra

# Environment: development | production
NODE_ENV=development

# Payments (disabled by default; see payments module)
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=

# Server port
PORT=3000

# Run pending migrations automatically on startup (true | false)
DB_MIGRATIONS_RUN=true

# Observability (optional — disabled when unset)
SENTRY_DSN=
# 0..1 fraction of requests traced (default 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# fatal | error | warn | info | debug | trace (default: info in prod, debug in dev)
LOG_LEVEL=

# AI / OpenRouter (optional — features fall back to templates when unset)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TEXT_MODEL=openai/gpt-4o-mini
AI_VISION_MODEL=openai/gpt-4o
AI_ANALYSIS_MODEL=openai/gpt-4o-mini
AI_FALLBACK_ENABLED=true
# Giphy API key for the GIF search proxy (optional — disables GIF search when unset)
GIPHY_API_KEY=your_giphy_api_key

# Email (SMTP) — required for real verification/password-reset emails.
# Falls back to console logging when SMTP_HOST is unset. Resend example below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address. Must be allowed by your provider (e.g. verified domain, or Resend's onboarding@resend.dev sandbox).
FROM_EMAIL=
